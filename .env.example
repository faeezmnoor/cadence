# Cadence — environment variables
# Copy to apps/web/.env.local for local dev. Set the same vars in Vercel for prod.

# --- Database (Supabase, Singapore region) ---
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Supabase (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (magic link via Resend SMTP) ---
RESEND_API_KEY=
EMAIL_FROM=Cadence <noreply@yourdomain.com>

# --- LLMs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# CAD-215: founder/admin chat id for operational pings — currently the
# "Request credits" button on /settings/billing. Message the bot from the
# founder account and read the chat id from the webhook payload (or use
# @userinfobot). Leave unset to skip the ping; the billing UI then falls
# back to the support-email line.
ADMIN_TELEGRAM_CHAT_ID=

# --- Search ---
BRAVE_SEARCH_API_KEY=

# --- Pro tier (Phase 5.1, CAD-100) ---
# Perplexity Sonar Reasoning Pro — used by the Pro tier search provider.
# Get a key at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Gate the Pro tier behind an alpha flag. Set to "true" to enable
# Pro tier alpha — review /admin/evals before flipping public.
# Accepted opt-in values: "1" or "true". Anything else (including unset,
# "0", "false") routes Pro requests through the default bundle.
PRO_TIER_ALPHA=false  # set to true to enable Pro tier alpha — see /admin/evals before flipping public

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=cadence

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
