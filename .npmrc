# pnpm 11 exits non-zero when ignored builds are present (strict-builds=true
# by default). Vercel + CI rely on default install; flip it off so the
# warning stays a warning. onlyBuiltDependencies in pnpm-workspace.yaml
# already whitelists what we actually want built.
strict-builds=false
strict-dep-builds=false
strictDepBuilds=false
verify-deps-before-run=false
