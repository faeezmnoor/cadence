# pnpm 11 reads build-related settings from pnpm-workspace.yaml, not .npmrc.
# The previous `strict-builds` / `strict-dep-builds` entries here were silently
# ignored — canonical location is `strictDepBuilds: false` in
# pnpm-workspace.yaml, alongside the `allowBuilds` allowlist.
#
# `verify-deps-before-run=false` is still honored here and disables pnpm 11's
# pre-script re-install check that re-triggers ERR_PNPM_IGNORED_BUILDS even
# when the prior install succeeded.
verify-deps-before-run=false
