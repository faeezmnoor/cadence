{
  "name": "cadence",
  "version": "0.0.1",
  "private": true,
  "description": "Cadence — periodical self-learning market-research digests on Telegram.",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter web test",
